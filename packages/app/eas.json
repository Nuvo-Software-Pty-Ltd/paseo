{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_SELF_HOST_ENABLED": "false",
        "EXPO_PUBLIC_POSTHOG_KEY": "phc_v36ZtpJRGwzRATn9eF2mjQqAdXnx97XaozE7KLPwTNd4",
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_POSTHOG_KEY": "phc_v36ZtpJRGwzRATn9eF2mjQqAdXnx97XaozE7KLPwTNd4",
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com"
      },
      "android": {
        "autoIncrement": "versionCode"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -x lint -x lintVitalAnalyzeRelease -x lintVitalRelease -x generateReleaseLintModel -x generateReleaseLintVitalModel"
      }
    },
    "testflight": {
      "extends": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SELF_HOST_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6780445862"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6780445862"
      }
    }
  }
}
