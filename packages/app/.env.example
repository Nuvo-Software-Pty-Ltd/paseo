# Orchestra cloud service URLs
# Copy this file to .env and fill in values for your environment.

# Auth service base URL.
# Dev:     https://auth.dev.orchestra.nuvo.software  (default — matches code fallback)
# Staging: https://auth.staging.orchestra.nuvo.software
# Prod:    https://auth.orchestra.nuvo.software
EXPO_PUBLIC_ORCHESTRA_AUTH_URL=https://auth.dev.orchestra.nuvo.software

# Per-workspace daemon hostname suffix.
# Each workspace WS URL is derived as wss://<wsId-dots>.SUFFIX/ws
# Dev:     dev.orchestra.nuvo.software  (default — matches code fallback)
# Staging: staging.orchestra.nuvo.software
# Prod:    orchestra.nuvo.software
EXPO_PUBLIC_ORCHESTRA_DAEMON_HOSTNAME_SUFFIX=dev.orchestra.nuvo.software

# Dev-only single-daemon override. Bypasses workspace-based URL derivation.
# Only one workspace is reachable while set; do NOT use in staging or prod.
# Example: ws://localhost:6767/ws
# EXPO_PUBLIC_ORCHESTRA_DAEMON_WS_URL=

# Self-host connection methods on the welcome screen (Direct connection,
# Paste pairing link, Scan QR code). Default (unset / any value other than
# "false") shows them — the right default for self-hosted and desktop builds.
# The Orchestra cloud web build sets this to "false" so the welcome screen
# offers ONLY "Connect to Orchestra".
# EXPO_PUBLIC_SELF_HOST_ENABLED=true

# PostHog — product analytics, session replay, and crash/error tracking.
# Public project key (phc_...) — safe to embed in client bundles. Leave UNSET
# in self-host / open-source builds so the app never sends telemetry; only the
# Orchestra cloud builds inject it (eas.json for iOS, deploy-web.yml for web).
# Uncomment both to capture a local `expo start --web` session into the
# "Orchestra" project (US cloud).
# EXPO_PUBLIC_POSTHOG_KEY=phc_v36ZtpJRGwzRATn9eF2mjQqAdXnx97XaozE7KLPwTNd4
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
